# Обязательные секреты production. Создайте случайные значения:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_GRANT_SECRET=replace-with-a-long-random-download-secret
CLEANUP_KEY=replace-with-a-long-random-cleanup-key
# Separate key for daily HMAC-hashing server IPs in consented telemetry.
TELEMETRY_HASH_SECRET=replace-with-a-long-random-telemetry-secret
# Optional: retention for telemetry events, default 30 days.
TELEMETRY_RETENTION_DAYS=30
# 32-byte base64url key for encrypting every new file in storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FILE_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key
# Адрес приложения для ссылок восстановления пароля.
APP_URL=https://files.example.com

# SMTP нужен для отправки ссылок восстановления пароля в production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=FileShare <no-reply@example.com>

# Telegram application credentials, нужны локальному Telegram Bot API серверу.
# Получите на https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-telegram-api-hash

# Docker Compose задаёт эти переменные автоматически. Для локального запуска
# без Docker оставьте TELEGRAM_API_BASE пустым: лимит будет 50 МБ.
# TELEGRAM_API_BASE=http://localhost:8081
# UPLOAD_TEMP_DIR=/var/filesshare/uploads
# TRUST_PROXY=1

# Прокси для Telegram — только если VPN выключен.
# TELEGRAM_PROXY=http://127.0.0.1:7890
