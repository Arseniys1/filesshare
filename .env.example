# Ключ администратора для защиты админ-панели (необязательно)
# Если не задан, админ-панель доступна без авторизации
ADMIN_KEY=your-secret-admin-key-here

# Порт (по умолчанию 3000)
PORT=3000

# Прокси для Telegram — только если VPN выключен
# TELEGRAM_PROXY=http://127.0.0.1:7890

# === Лимит размера файлов ===
# Без этой строки: максимум 50 МБ (лимит облачного Telegram Bot API)
# С локальным Bot API сервером: до 2 ГБ
#
# 1. Скачай telegram-bot-api: https://github.com/tdlib/telegram-bot-api
# 2. Запусти: telegram-bot-api --api-id=XXX --api-hash=XXX --local
# 3. Отключи бота от облака: https://api.telegram.org/bot<TOKEN>/logout
# 4. Раскомментируй строку ниже:
#
# TELEGRAM_API_BASE=http://localhost:8081
